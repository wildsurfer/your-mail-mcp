# Copy to .env. Never commit .env.
#
# Exactly the URL the connector is given, without /mcp. Local test:
# http://127.0.0.1:8080. Behind a reverse proxy: https://mail.example.com.
PUBLIC_URL=http://127.0.0.1:8080
# Typed once on the consent page when the connector is added.
OAUTH_PASSPHRASE=change-me
SYNC_INTERVAL=10m
# Raise for the first mirror of a large mailbox, e.g. 8h.
SYNC_TIMEOUT=1h
