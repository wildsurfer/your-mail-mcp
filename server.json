{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.wildsurfer/your-mail-mcp",
  "description": "Read-only, self-hosted MCP access to IMAP email, mirrored locally and indexed by notmuch.",
  "repository": {
    "url": "https://github.com/wildsurfer/your-mail-mcp",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/wildsurfer/your-mail-mcp:0.3.0",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8080/mcp"
      },
      "environmentVariables": [
        {
          "name": "PUBLIC_URL",
          "description": "Public base URL the server is reached at (used for OAuth metadata)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "OAUTH_PASSPHRASE",
          "description": "Passphrase gating the OAuth consent step",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/wildsurfer/your-mail-mcp:0.3.0",
      "transport": { "type": "stdio" },
      "runtimeHint": "docker",
      "runtimeArguments": [
        { "type": "positional", "value": "run" },
        { "type": "positional", "value": "-i" },
        { "type": "positional", "value": "--rm" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "stdio" }
      ]
    }
  ]
}
